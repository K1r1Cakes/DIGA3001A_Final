  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "There were four of us. Now it\u2019s just me. We have been stranded for
    weeks. The plane we were on deteriorated across the island. My team believed
    that they could build a radio with the debris. \r\n\r\nA microcontroller, remote
    and antenna was all we needed.\r\n\r\nBut something went wrong. They started
    talking to this pit like crazy people\u2026 Something about trading? \r\n\r\nThen
    they started to disappear one by one. Maybe it was those pesky crabs. If anybody
    fibds this note\u2026 STAY ON THE BEACH. ITS NOT WORTH IT.\n\nTake the sling
    shot... in case something comes.\r\n"
  m_isRightToLeft: 0
